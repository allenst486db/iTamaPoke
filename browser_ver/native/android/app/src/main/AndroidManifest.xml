<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No <uses-permission>: the app needs neither network nor storage.
         Files the player picks arrive through the system picker as
         content:// URIs the WebView reads directly. -->

    <!-- The launcher icon is generated at build time from
         Resources/DefaultAppIcon.png (the generic egg mascot) into
         res/mipmap-*/ic_launcher.png -- see the CI workflow. For a local
         Android Studio build, add one with Image Asset, or drop any PNG at
         app/src/main/res/mipmap-xxxhdpi/ic_launcher.png. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="iTamaPoke"
        android:theme="@style/Theme.AppCompat.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
