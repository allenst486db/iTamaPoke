<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No android:icon: add your own @mipmap/ic_launcher in Android Studio's
         Image Asset tool once this builds -- omitted here so a fresh checkout
         builds without any binary asset this repo doesn't ship. -->
    <application
        android:allowBackup="false"
        android:label="iTamaPoke"
        android:theme="@style/Theme.AppCompat.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
