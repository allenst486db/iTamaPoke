# Xcode / build
*.xcodeproj/
*.xcworkspace/
DerivedData/
build/
build_*/
*.xcarchive
*.ipa
.DS_Store

# Sprites are NOT redistributed: copied per-user from the upstream checkout.
# See README "Sprites" and Scripts/fetch_sprites.sh
# The directory itself stays tracked but empty, so the Xcode folder reference
# resolves in a fresh checkout; only its contents are ignored.
Resources/mons/*
!Resources/mons/.gitkeep
Resources/*.pak

# App icon: a Pokemon character collage, same reasoning as the sprites above.
# Contents.json (the appiconset's structure, no art) stays tracked; only the
# image is ignored. See README "App icon" and Scripts/fetch_app_icon.sh.
Sources/iOS/Assets.xcassets/AppIcon.appiconset/AppIcon.png
Sources/watchOS/Assets.xcassets/AppIcon.appiconset/AppIcon.png
# Same file, wherever a custom source copy gets dropped before running
# fetch_app_icon.sh -- Resources/DefaultAppIcon.png (the generic mascot) is
# the only icon PNG meant to be tracked.
Resources/AppIcon.png

# browser_ver: build.sh's output. Regenerated from upstream-expanded/*.cpp
# (unmodified) + browser_ver/core -- not worth committing, same reasoning as
# build/ above. See browser_ver/README.md.
browser_ver/web/tp_core.js
browser_ver/web/tp_core.wasm
# Copied from Resources/DefaultAppIcon.png by the deploy workflow (or by
# hand for a local test); one source of truth for the icon.
browser_ver/web/icon.png
# The Android shell's bundled copy of web/ and generated launcher icons
# (both produced by the workflow), plus Gradle output.
browser_ver/native/android/app/src/main/assets/
browser_ver/native/android/app/src/main/res/mipmap-*/
browser_ver/native/android/.gradle/
browser_ver/native/android/app/build/
browser_ver/native/android/local.properties
